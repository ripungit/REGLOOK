{
    "info": {
        "name": "Sandbox API",
        "description": "NestJS API with cookie sessions, CSRF, and WebAuthn passkeys",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://178.156.223.139:9100",
            "type": "string"
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Get CSRF token from cookie and set header",
                    "const csrf = pm.cookies.get('csrf_token');",
                    "if (csrf) {",
                    "    pm.request.headers.add({",
                    "        key: 'x-csrf-token',",
                    "        value: csrf",
                    "    });",
                    "}"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "Health",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                ""
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Get CSRF Token",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/auth/csrf",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "csrf"
                            ]
                        }
                    }
                },
                {
                    "name": "Signup - Start",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"username\": \"johndoe\",\n  \"marketingOptIn\": false\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/signup/start",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "signup",
                                "start"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const response = pm.response.json();",
                                    "if (response.userId) {",
                                    "    pm.collectionVariables.set('userId', response.userId);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Signup - Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"password\": \"SecurePassword123!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/signup/password",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
